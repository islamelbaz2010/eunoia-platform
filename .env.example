# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key

# Database (required)
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# AI (required)
OPENAI_API_KEY=sk-...
RESEND_API_KEY=re_...
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin access (required — comma-separated list of admin email addresses)
# Used by all /api/admin/* routes and the pilot dashboard
ADMIN_EMAILS=you@example.com

# Redis (optional — required for rate limiting and caching)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# Cloudflare Worker fallback (optional)
CLOUDFLARE_WORKER_URL=https://halannews.com/api-proxy

# SerpAPI (optional — required for the Research Core Engine's SearchProvider)
SERPAPI_API_KEY=your-serpapi-key

# Shared daily search budget across the whole app (optional, defaults to 150)
SEARCH_DAILY_QUOTA=150

# Per-tenant fair-share sub-quota out of the shared budget above — stops one
# tenant (e.g. an unlimited-plan Enterprise account) from exhausting the
# whole platform's daily search budget (optional, defaults to 30)
SEARCH_DAILY_QUOTA_PER_USER=30

# Apollo.io (optional — enrichment only, the Research Core Engine works fully without it)
APOLLO_API_KEY=your-apollo-key
