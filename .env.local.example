# Copy this file to .env.local and fill in your values
# NEVER commit .env.local — it's in .gitignore

# Supabase (required) — get from https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Database (required) — get from Supabase dashboard → Settings → Database
# Use pgBouncer (Transaction mode) URL for DATABASE_URL
DATABASE_URL=postgresql://postgres.xxx:password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.xxx:password@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# AI (required) — get from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# Redis (optional — enables rate limiting and 24h report caching)
# Get from https://console.upstash.com
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token-here

# Cloudflare Worker fallback (optional — auto-failover if OpenAI is down)
CLOUDFLARE_WORKER_URL=https://halannews.com/api-proxy

# SerpAPI (optional — required for the Research Core Engine's SearchProvider;
# without it, SerpApiProvider throws a clear error instead of falling back to
# AI-invented results). Get an API key from https://serpapi.com/manage-api-key
SERPAPI_API_KEY=your-serpapi-key

# Shared daily search budget across the whole app (optional, defaults to 150 —
# size this against your actual purchased SerpAPI plan's monthly allowance)
SEARCH_DAILY_QUOTA=150

# App URL (used for Supabase email redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
